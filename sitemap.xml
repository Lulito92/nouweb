<?xml version="1.0" encoding="UTF-8"?>
<!--
    Mapa del sitio de Nouweb. Creado en la Fase 10 (2026-07-22): el sitio no
    tenía ninguno.

    ⚠️ AL PUBLICAR UN ARTÍCULO HAY QUE AÑADIRLO ACÁ. Es el único paso del
    proceso que no se puede automatizar sin un generador, y por eso está
    escrito en blog/README.md como paso 3 de 4.

    Qué NO va en este archivo:
      · La raíz `/` y /es/ — redirigen a /es-es/ (vercel.json, 2026-10-12).
        Una URL que redirige no se declara nunca: Google la cuenta como error
        de cobertura.
      · /en/ y /de/ — congeladas hasta las fases 6 y 7. Se añaden cuando
        cuenten la oferta nueva; hoy contradicen a la home en español.
      · /blog/_plantilla.html — es el molde, no una página. Además lleva
        noindex.
      · login.html, dashboard.php, briefing.html y el resto del backend: son
        privadas o de trabajo interno. robots.txt bloquea las que importan.

    Sobre <lastmod>: es la fecha del último cambio REAL del contenido. Si se
    pone la de hoy en todas cada vez que se sube algo, Google aprende que la
    señal no vale nada y deja de mirarla.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">

    <!-- Las dos versiones en español. Desde el 2026-10-12 (decisión de Luis)
         España es la versión por defecto: la raíz redirige a /es-es/, y Perú,
         que era la raíz, vive en /es-pe/. Son páginas distintas, no
         traducciones: mismo idioma, otro marco fiscal y otro cliente.

         El grupo hreflang NO se repite aquí. Se declara en el <head> de las dos
         páginas, que ya es recíproco; duplicarlo en el sitemap solo crea un
         segundo sitio donde puede quedarse desactualizado y decir lo contrario
         que el HTML. -->
    <url>
        <loc>https://nouweb-es.com/es-es/</loc>
        <lastmod>2026-10-12</lastmod>
        <changefreq>monthly</changefreq>
        <priority>1.0</priority>
    </url>

    <url>
        <loc>https://nouweb-es.com/es-pe/</loc>
        <lastmod>2026-10-12</lastmod>
        <changefreq>monthly</changefreq>
        <priority>1.0</priority>
    </url>

    <url>
        <loc>https://nouweb-es.com/blog/</loc>
        <lastmod>2026-07-22</lastmod>
        <changefreq>weekly</changefreq>
        <priority>0.8</priority>
    </url>

    <!-- Artículos del blog, del más nuevo al más viejo. -->
