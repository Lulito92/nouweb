{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/", "destination": "/es-es/", "statusCode": 302 },
    { "source": "/index.html", "destination": "/es-es/", "statusCode": 302 },
    { "source": "/es", "destination": "/es-es/", "statusCode": 301 },
    { "source": "/es/", "destination": "/es-es/", "statusCode": 301 },
    { "source": "/es/index.html", "destination": "/es-es/", "statusCode": 301 },
    { "source": "/es-pe", "destination": "/es-pe/", "statusCode": 301 },
    { "source": "/es-pe/index.html", "destination": "/es-pe/", "statusCode": 301 },
    { "source": "/es-es", "destination": "/es-es/", "statusCode": 301 },
    { "source": "/en", "destination": "/en/", "statusCode": 301 },
    { "source": "/de", "destination": "/de/", "statusCode": 301 },
    { "source": "/blog", "destination": "/blog/", "statusCode": 301 }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=(), payment=()" }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|mp4)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000" }
      ]
    }
  ]
}
